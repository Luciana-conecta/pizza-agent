# Llave de NVIDIA (ya la tenías en request_router). Se usa para clasificar
# los mensajes y para que respondan todos los agentes.
NVIDIA_API_KEY=

# Token del bot que te dio @BotFather en Telegram.
TELEGRAM_BOT_TOKEN=

# El chat_id de la dueña/dueño de la pizzería. Ahí llegan las escalaciones
# de quejas, y solo desde ese chat funcionan las consultas administrativas
# y el comando /estado. Para conseguirlo: hablale a tu bot una vez y mirá
# los logs, o usá @userinfobot en Telegram.
OWNER_TELEGRAM_CHAT_ID=

# Cadena de conexión a la base Postgres. Como el bot corre en el mismo VPS
# que la base, se usa localhost.
DATABASE_URL=postgresql://usuario:password@localhost:5432/nombre_db
